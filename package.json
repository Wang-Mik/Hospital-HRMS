{
  "name": "hospital-hrm",
  "version": "1.0.0",
  "description": "Hospital Human Resources Management System (HRMS) with Work Process Tracking",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "start": "npm start --workspace=backend",
    "test": "npm test --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:wipe": "npm run db:wipe --workspace=backend",
    "db:seed": "node scripts/seed-database.js",
    "db:init": "npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
