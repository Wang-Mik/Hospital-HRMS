  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Hospital HRMS - System Overview & Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Throughput (QPS by Status)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status_code) (rate(hospital_hrm_http_requests_total[1m]))",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "API Request Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hospital_hrm_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 (Median)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hospital_hrm_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hospital_hrm_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "MySQL Connection Pool Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hospital_hrm_mysql_pool_connections{state=\"active\"}",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "hospital_hrm_mysql_pool_connections{state=\"free\"}",
          "legendFormat": "Free/Idle Connections"
        },
        {
          "expr": "hospital_hrm_mysql_pool_connections{state=\"queued\"}",
          "legendFormat": "Queued Connection Requests"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Node.js Process & Host Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "title": "Memory Usage (Resident Set Size)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hospital_hrm_process_resident_memory_bytes",
          "legendFormat": "Process RSS"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "title": "CPU Usage Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(hospital_hrm_process_cpu_user_seconds_total[1m]) + rate(hospital_hrm_process_cpu_system_seconds_total[1m])",
          "legendFormat": "CPU Usage"
        }
      ]
    }
  ],
